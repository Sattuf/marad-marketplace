# Copy to infra/.env and fill in — or run `make env` to generate one with random secrets.
# Generate a secret by hand with: openssl rand -hex 32
# Never commit infra/.env (it is git-ignored).

# --- Database -----------------------------------------------------------------
POSTGRES_USER=marad
POSTGRES_DB=marad_db
POSTGRES_PASSWORD=

# --- Secrets (no defaults: services refuse to start without them) ---------------
# Access tokens are RS256: auth-service signs with the private key, every service verifies
# with the public JWK Set. Generate both with: node scripts/gen-jwt-keys.mjs (make env does it).
JWT_PUBLIC_JWKS=
# auth-service only (PEM, base64 on one line)
JWT_PRIVATE_KEY_B64=
# auth-service only: HMAC secret of refresh tokens (never leave auth-service)
JWT_REFRESH_SECRET=
# Service-to-service calls (X-Internal-Secret header)
INTERNAL_SECRET=
# identity-service: HMAC secret configured in the Didit dashboard
DIDIT_WEBHOOK_SECRET=
# Prometheus -> gateway /metrics (bearer token)
METRICS_TOKEN=
# Grafana admin password (user: admin)
GRAFANA_ADMIN_PASSWORD=

# --- Runtime --------------------------------------------------------------------
# development enables Swagger UI and the mock OTP sender; production refuses both.
NODE_ENV=development
LOG_LEVEL=info
# Development only: OTP codes are logged instead of sent by SMS.
OTP_MOCK_ENABLED=true
# Launch wave (packages/markets/markets.json): 1 = Turkey + Saudi Arabia, 2 = + Gulf and Egypt,
# 3 = + Syria and the Maghreb, 4 = + Europe, 5 = + East Asia. Only these countries receive OTP SMS.
MARKETS_ACTIVE_WAVE=1
# Optional explicit list of calling codes without + (overrides the wave), e.g. 90,966
OTP_ALLOWED_CALLING_CODES=
# Currency of a new listing when the app sends none: TRY (Turkey) or SAR (Saudi Arabia) at launch.
DEFAULT_LISTING_CURRENCY=TRY
# Browser origins allowed by CORS (comma separated).
CORS_ORIGINS=http://localhost:3100

# Testing on a real phone: 0.0.0.0 exposes the gateway (3000) and chat (3004) on your
# Wi-Fi network. Leave empty (localhost only) otherwise; use it only on a trusted network.
DEVICE_BIND=
# The gateway as the phone sees it, used in uploaded image URLs, e.g.
# PUBLIC_API_URL=http://192.168.1.20:3000/api/v1 (default http://localhost:3000/api/v1).
PUBLIC_API_URL=
# The chat socket as the browser/phone sees it (default http://localhost:3004).
PUBLIC_SOCKET_URL=

# --- Optional integrations (empty = disabled) -----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DIDIT_API_KEY=

# --- Building behind a TLS-intercepting proxy (corporate networks) ---------------
# Path to an extra CA bundle used only during image builds; never copied into images.
EXTRA_CA_CERT=
